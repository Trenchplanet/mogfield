# Copy this file to app/.env and fill in what you need. app/.env is gitignored:
# your key stays on your machine and is only sent to Comfy with your own jobs.

# --- Comfy -------------------------------------------------------------------

# Your Comfy API key (https://platform.comfy.org). Needed for "API" mode
# (Comfy Cloud) and for partner models such as Seedance, also in LOCAL mode.
COMFY_API_KEY=

# LOCAL mode: your own ComfyUI. Leave unset to run on Comfy Cloud.
# A plain ComfyUI, comfy-api-proxy, or a RunPod-style proxy URL all work.
# You can also switch this at runtime from the API / LOCAL toggle in the app.
# COMFY_BASE_URL=http://127.0.0.1:8189

# Force the render engine: "comfy" or "preview" (ffmpeg-only, no GPU).
# Defaults to "comfy" when COMFY_BASE_URL is set, otherwise "preview".
# BACKLOT_ENGINE=

# --- Models (optional overrides) ---------------------------------------------

# Pin the exact Seedance model id from your Comfy catalog.
# MOGFIELD_SEEDANCE_MODEL=bytedance/seedance-2-5
# Send Seedance through the Comfy model router instead of a workflow.
# MOGFIELD_SEEDANCE_VIA=router
# Model for character reference sheets and for character cards.
# MOGFIELD_SHEET_MODEL=vertexai/gemini-nano-banana-2.1
# MOGFIELD_CAST_MODEL=bfl/flux-3-image
# Model that directs Agent mode and reads style pictures in Restyle.
# MOGFIELD_AGENT_MODEL=anthropic/claude-sonnet-5-5
# How a prepared take's pitched vocals reach Seedance: embedded | separate | off
# MOGFIELD_PREP_AUDIO=embedded

# --- Server ------------------------------------------------------------------

# API port (default 8787). In `npm run dev`, PORT is the Vite port (default 5173).
# BACKLOT_PORT=8787
# BACKLOT_HOST=127.0.0.1
# Where uploads, renders and depth maps are stored (default app/data).
# BACKLOT_DATA_DIR=
# Where preparation artifacts are stored (default app/.private-data).
# BACKLOT_PRIVATE_DIR=
# Max renders per visitor IP per day; 0 disables the cap.
# BACKLOT_RENDER_CAP=0
# Character sheets per visitor per day (defaults to 2 when a render cap is set).
# MOGFIELD_SHEET_CAP=
# BACKLOT_MAX_UPLOAD_MB=200
# Repo shown by the GitHub button and in share captions.
# BACKLOT_REPO_URL=github.com/<you>/mogfield

# --- Tools -------------------------------------------------------------------

# Rubber Band (brew install rubberband) for the +3-semitone vocal shift.
# RUBBERBAND_BIN=rubberband
# Python used for the preparation media helper.
# PYTHON_BIN=python3

# Pasted TikTok / Instagram / X links are fetched with yt-dlp (brew install yt-dlp).
# Instagram usually needs a logged-in session: read cookies from a browser or a cookies.txt.
# BACKLOT_YTDLP=yt-dlp
# BACKLOT_YTDLP_COOKIES_FROM_BROWSER=chrome
# BACKLOT_YTDLP_COOKIES=/path/to/cookies.txt

# --- Public demo -------------------------------------------------------------

# 1 = every visitor gets their own private library (cookie based) that is deleted
# after the hours below. Leave it off when you run MOGFIELD for yourself.
# BACKLOT_PER_VISITOR=1
# BACKLOT_VISITOR_TTL_HOURS=24
