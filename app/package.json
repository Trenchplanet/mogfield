{
  "name": "mogfield-app",
  "version": "1.0.1",
  "description": "MOGFIELD web app (Vite + React) and server (Hono + @comfyorg/sdk).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@comfyorg/sdk": "^0.5.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
