{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "depth-color.mp4"
    },
    "_meta": {
      "title": "BL:video"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Video components"
    }
  },
  "3": {
    "class_type": "SAM3VideoSegmentation",
    "inputs": {
      "video_frames": [
        "2",
        0
      ],
