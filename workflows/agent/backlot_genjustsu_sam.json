      "text_prompt": "person",
      "frame_idx": 0,
      "score_threshold": 0.3
    },
    "_meta": {
      "title": "BL:segment"
    }
  },
  "4": {
    "class_type": "LoadSAM3Model",
    "inputs": {
      "model_path": "models/sam3/sam3.pt"
    },
    "_meta": {
      "title": "Load SAM 3"
    }
  },
  "5": {
    "class_type": "SAM3Propagate",
    "inputs": {
      "sam3_model": [
        "4",
        0
      ],
      "video_state": [
        "3",
        0
      ],
      "start_frame": 0,
      "end_frame": -1,
      "direction": "both",
      "offload_model": false
    },
    "_meta": {
      "title": "Track SAM 3 masks"
    }
  },
  "6": {
    "class_type": "SAM3VideoOutput",
    "inputs": {
      "masks": [
