  },
  "8": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "7",
        0
      ],
      "fps": [
        "2",
        2
      ],
      "codec": "h264"
    },
    "_meta": {
      "title": "Assemble masks"
    }
  },
  "9": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "8",
        0
      ],
      "filename_prefix": "backlot/genjustsu-masks",
      "format": "mp4",
      "format.codec": "h264",
      "codec": "h264"
